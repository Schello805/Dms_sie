[Unit]
Description=IMS-DMS review reminder email worker
After=network.target postgresql.service

[Service]
User=ims-dms
Group=ims-dms
WorkingDirectory=/opt/ims-dms
EnvironmentFile=/etc/ims-dms-notifications.env
ExecStart=/opt/ims-dms/.venv/bin/python manage.py process_notifications
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ims-dms/health /var/lib/ims-dms/logs
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
