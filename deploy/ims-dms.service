[Unit]
Description=IMS document management
After=network.target postgresql.service

[Service]
User=ims-dms
Group=ims-dms
WorkingDirectory=/opt/ims-dms
EnvironmentFile=/etc/ims-dms.env
ExecStart=/opt/ims-dms/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ims-dms
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
