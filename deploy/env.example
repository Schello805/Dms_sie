DMS_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DMS_DEBUG=0
DMS_ALLOWED_HOSTS=dms.example.internal
DMS_TRUST_PROXY=1
DMS_MEDIA_ROOT=/var/lib/ims-dms/files
PGDATABASE=ims_dms
PGUSER=ims_dms_app
PGPASSWORD=REPLACE_WITH_DATABASE_PASSWORD
PGHOST=127.0.0.1
PGPORT=5432

DMS_ERROR_LOG_DIR=/var/lib/ims-dms/logs
# Optional: separate stable Fernet key for LDAP credentials (otherwise derived from DMS_SECRET_KEY).
# DMS_LDAP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

DMS_HEALTH_DIR=/var/lib/ims-dms/health
DMS_DYNAMIC_HOSTS=1
